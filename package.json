{
  "name": "upvest-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for Upvest Investment API simulation, signature generation, and webhook diagnostics",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "upvest-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "upvest",
    "fintech",
    "investment-api",
    "trading"
  ],
  "author": "Shalom",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
